# Public repository: code, configuration examples, documentation and aggregate figures.
# Local copies of research records, source texts and reference documents are retained here.
/local_archive/

# Local agent instructions and editor state
AGENTS.md
CLAUDE.md
.claude/
.cursorrules
.github/copilot-instructions.md
.DS_Store

# Credentials and local configuration
.env
.env.*
!.env.example
.kli_api_key
.API_KEY
pipeline/config.*.json
!pipeline/config.example.json
pipeline/configs/*.local.json
baselines/config.local.json

# Environments, model caches and binaries
.venv/
.venv-adversarial/
__pycache__/
*.py[cod]
.pytest_cache/
.hf_cache/
tools/
models/
*.pt
*.pth
*.safetensors
*.gguf

# Corpus text, generated pairs, per-document scores and run outputs
dataset/
corpus/raw/
corpus/mirror/*.parquet
*.jsonl
*.jsonl.gz
logs/
review/
adversarial/runs/
adversarial/smoke/_run/
adversarial/smoke/_smoke_out.log
# Old run paths are ignored too, so restoring older local experiments is safe.
loop/runs/
loop/smoke/_run/
loop/smoke/_smoke_out.log
pilot/export/
pilot/scores/copykiller/
tmp/

# Reference documents and exports containing original text
MASH.md
*.pdf
*.pptx
*.docx
*.zip
*.gz
*.tgz

# Images are published only in the aggregate figure directory.
*.png
*.jpg
*.jpeg
!results/figures/*.png
!results/figures/*.jpg
!results/figures/*.jpeg
